{
  "name": "@rosen-bridge/bitcoin-runes-utxo-selection",
  "version": "2.0.3",
  "description": "A Typescript package to select enough Bitcoin utxos for required amount of BTC and Runes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/selection.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --run --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run clean && npm run build && npm run test -- --run && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rosen-bridge/abstract-box-selection": "^1.0.2",
    "@rosen-bridge/selection-types": "^1.0.1"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
